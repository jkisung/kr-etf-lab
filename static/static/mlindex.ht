<!doctype html>
<html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>KR ETF Lab</title>
<style>
:root{--bg:#0f1115;--card:#181b22;--line:#2a2f3a;--tx:#e8eaf0;--mu:#8b93a5;--ac:#4f8cff;--up:#ff5a5f;--dn:#4f8cff}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font:14px/1.5 -apple-system,"Apple SD Gothic Neo","Noto Sans KR",sans-serif}
header{padding:14px 18px;border-bottom:1px solid var(--line);display:flex;gap:12px;align-items:baseline;flex-wrap:wrap}
h1{font-size:18px;margin:0}small,.mu{color:var(--mu)}
main{display:grid;grid-template-columns:1.2fr 1fr;gap:14px;padding:14px;max-width:1300px;margin:auto}
@media(max-width:900px){main{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px}
.card h2{font-size:15px;margin:0 0 8px}
input,select,button{background:#0f1218;color:var(--tx);border:1px solid var(--line);border-radius:6px;padding:6px 8px;font:inherit}
button{cursor:pointer}button.p{background:var(--ac);border-color:var(--ac);color:#fff}
.row{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:8px}
table{width:100%;border-collapse:collapse}th,td{padding:5px 6px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap}
th:first-child,td:first-child{text-align:left}th{color:var(--mu);font-weight:500;cursor:pointer}
.scroll{max-height:420px;overflow:auto}tr.sel td{background:#1d2433}tr.click{cursor:pointer}tr.click:hover td{background:#1d2433}
.up{color:var(--up)}.dn{color:var(--dn)}
.kv{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;margin:8px 0}
.kv div{background:#0f1218;border:1px solid var(--line);border-radius:8px;padding:6px 8px}.kv b{display:block;font-size:16px}
svg{width:100%;height:180px;background:#0f1218;border-radius:8px}
.err{color:#ff8a8a}footer{padding:14px;color:var(--mu);font-size:12px;text-align:center}
td input[type=number]{width:64px;text-align:right}
</style></head><body>
<header><h1>KR ETF Lab</h1><small>국내 상장 ETF 조회 · 포트폴리오 구성 도우미 (참고용, 투자 권유 아님)</small></header>
<main>
<section class="card"><h2>ETF 찾기</h2>
 <div class="row"><input id="q" placeholder="이름 또는 코드 (예: KODEX, 반도체, 069500)" style="flex:1;min-width:160px">
 <select id="cat"><option value="">전체 분류</option></select>
 <select id="sort"><option value="mcap_100m">시총순</option><option value="value_mil">거래대금순</option><option value="ret_3m">3개월 수익률순</option><option value="change_rate">등락률순</option></select></div>
 <div class="mu" id="cnt"></div>
 <div class="scroll"><table><thead><tr><th>종목</th><th>현재가</th><th>등락</th><th>3개월</th><th>괴리율</th><th>시총(억)</th></tr></thead><tbody id="list"></tbody></table></div>
 <div id="detail" style="margin-top:12px"></div>
</section>
<section class="card"><h2>포트폴리오</h2>
 <div class="mu" id="empty">왼쪽 목록에서 ETF를 클릭하면 담겨요. (최대 15개)</div>
 <table id="pt" style="display:none"><thead><tr><th>종목</th><th>비중(%)</th><th>금액(원)</th><th>수량</th><th></th></tr></thead><tbody id="pb"></tbody><tfoot><tr><td>합계</td><td id="wsum"></td><td id="asum"></td><td></td><td></td></tr></tfoot></table>
 <div class="row" style="margin-top:8px">투자금 <input id="amt" type="number" value="10000000" step="1000000" style="width:120px">
  기간 <select id="years"><option>1</option><option>3</option><option selected>5</option></select>년
  리밸런싱 <select id="reb"><option value="yearly">연 1회</option><option value="monthly">월 1회</option><option value="none">안 함</option></select></div>
 <div class="row">비중 자동 제안:
  <select id="method"><option value="inv_vol">변동성 역가중</option><option value="risk_parity">리스크 패리티</option><option value="min_var">최소분산</option><option value="equal">동일비중</option></select>
  종목당 최대 <select id="maxw"><option value="1">제한 없음</option><option value="0.5">50%</option><option value="0.4" selected>40%</option><option value="0.3">30%</option></select>
  <button id="sug">제안 적용</button> <button class="p" id="run">분석</button></div>
 <div id="res"></div>
</section>
</main>
<footer>데이터: 네이버 금융 공개 시세 (비공식, 지연/오류 가능) · 과거 수익률은 가격 기준(분배금 미포함) · 미래 수익을 보장하지 않아요</footer>
<script>
const $=s=>document.querySelector(s), fmt=n=>n==null?'-':Number(n).toLocaleString('ko-KR'), pc=(n,d=1)=>n==null?'-':(n*100).toFixed(d)+'%';
const cls=n=>n>0?'up':n<0?'dn':'';
let P=[], ETF={}; // portfolio [{code,name,price,weight}]
async function api(u,b){const r=await fetch(u,b?{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(b)}:{});const j=await r.json();if(!r.ok)throw new Error(j.error||'오류');return j}
async function load(){
 const p=new URLSearchParams({q:$('#q').value,cat:$('#cat').value,sort:$('#sort').value,limit:150});
 const d=await api('/api/etfs?'+p);
 if($('#cat').options.length==1)d.cats.forEach(c=>$('#cat').add(new Option(c,c)));
 $('#cnt').textContent=`${d.total}개 중 ${d.items.length}개 표시`;
 $('#list').innerHTML=d.items.map(e=>{ETF[e.code]=e;return `<tr class="click" data-c="${e.code}"><td>${e.name}<br><small>${e.code} · ${e.cat}</small></td><td>${fmt(e.price)}</td><td class="${cls(e.change_rate)}">${e.change_rate??'-'}%</td><td class="${cls(e.ret_3m)}">${e.ret_3m??'-'}%</td><td>${e.premium??'-'}%</td><td>${fmt(e.mcap_100m)}</td></tr>`}).join('');
}
let t;['q','cat','sort'].forEach(i=>$('#'+i).addEventListener('input',()=>{clearTimeout(t);t=setTimeout(load,250)}));
$('#list').addEventListener('click',e=>{const tr=e.target.closest('tr');if(tr)detail(tr.dataset.c)});
function line(pts,key,color='#4f8cff'){const v=pts.map(p=>p[key]),mn=Math.min(...v),mx=Math.max(...v),W=600,H=180;
 const path=v.map((y,i)=>`${i?'L':'M'}${(i/(v.length-1)*W).toFixed(1)},${(H-8-(y-mn)/(mx-mn||1)*(H-16)).toFixed(1)}`).join('');
 return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none"><path d="${path}" fill="none" stroke="${color}" stroke-width="2"/></svg>`}
async function detail(code){
 $('#detail').innerHTML='불러오는 중…';
 try{const d=await api('/api/etf/'+code),i=d.info,s=d.stats;
 $('#detail').innerHTML=`<h2>${i.name} <small>${i.code} · ${i.cat}</small></h2>
 <div class="kv"><div>현재가<b>${fmt(i.price)}</b></div><div>NAV<b>${fmt(i.nav)}</b></div><div>괴리율<b>${i.premium??'-'}%</b></div><div>시총(억)<b>${fmt(i.mcap_100m)}</b></div>
 ${s?`<div>연환산 수익<b>${pc(s.cagr)}</b></div><div>연 변동성<b>${pc(s.vol)}</b></div><div>최대낙폭<b>${pc(s.mdd)}</b></div><div>샤프(rf=0)<b>${s.sharpe.toFixed(2)}</b></div>`:''}</div>
 ${line(d.history,'c')}<div class="mu">최근 약 5년 종가 · 통계 ${s?s.days+'거래일':''}</div>
 <div class="row" style="margin-top:8px"><button class="p" onclick="add('${i.code}')">포트폴리오에 담기</button></div>`}catch(e){$('#detail').innerHTML=`<span class="err">${e.message}</span>`}}
function add(code){if(P.find(p=>p.code==code)||P.length>=15)return;const e=ETF[code];P.push({code,name:e.name,price:e.price,weight:0});equalize();render()}
function equalize(){const w=Math.floor(1000/P.length)/10;P.forEach(p=>p.weight=w);}
function render(){$('#empty').style.display=P.length?'none':'';$('#pt').style.display=P.length?'':'none';
 const amt=+$('#amt').value||0;let ws=0,as=0;
 $('#pb').innerHTML=P.map((p,i)=>{const a=amt*p.weight/100,q=Math.floor(a/p.price);ws+=p.weight;as+=q*p.price;
  return `<tr><td>${p.name}<br><small>${p.code}</small></td><td><input type="number" step="0.1" value="${p.weight}" data-i="${i}"></td><td>${fmt(Math.round(a))}</td><td>${fmt(q)}주</td><td><button data-x="${i}">✕</button></td></tr>`}).join('');
 $('#wsum').textContent=ws.toFixed(1)+'%';$('#asum').textContent=fmt(as)+' (매수 가능액)'}
$('#pb').addEventListener('input',e=>{if(e.target.dataset.i!=null){P[e.target.dataset.i].weight=+e.target.value;recalc()}});
$('#pb').addEventListener('click',e=>{if(e.target.dataset.x!=null){P.splice(e.target.dataset.x,1);render()}});
function recalc(){const amt=+$('#amt').value||0;let ws=0;P.forEach(p=>ws+=p.weight);$('#wsum').textContent=ws.toFixed(1)+'%'}
$('#amt').addEventListener('input',render);
const body=()=>({items:P.map(p=>({code:p.code,weight:p.weight})),years:+$('#years').value,rebalance:$('#reb').value});
$('#sug').onclick=async()=>{if(!P.length)return;$('#res').innerHTML='계산 중…';try{
 const d=await api('/api/suggest',{...body(),method:$('#method').value,max_weight:+$('#maxw').value});
 P.forEach(p=>p.weight=Math.round(d.weights[p.code]*1000)/10);render();$('#res').innerHTML='<span class="mu">비중을 반영했어요. “분석”으로 백테스트를 확인하세요.</span>'}catch(e){$('#res').innerHTML=`<span class="err">${e.message}</span>`}};
$('#run').onclick=async()=>{if(!P.length)return;$('#res').innerHTML='계산 중…';try{
 const d=await api('/api/portfolio',body()),s=d.stats;
 const corr=P.length>1?`<h2 style="margin-top:12px">상관계수</h2><table><tr><th></th>${P.map(p=>`<th>${p.code}</th>`).join('')}</tr>${d.corr.map((r,i)=>`<tr><td>${P[i].code}</td>${r.map(x=>`<td style="background:rgba(79,140,255,${Math.max(x,0)*.5})">${x.toFixed(2)}</td>`).join('')}</tr>`).join('')}</table>`:'';
 $('#res').innerHTML=`<div class="mu">${d.start} ~ ${d.end} (${d.days}거래일, 겹치는 기간 기준)</div>
 <div class="kv"><div>누적수익<b class="${cls(s.total)}">${pc(s.total)}</b></div><div>연환산 수익<b>${pc(s.cagr)}</b></div><div>연 변동성<b>${pc(s.vol)}</b></div><div>최대낙폭<b>${pc(s.mdd)}</b></div><div>샤프(rf=0)<b>${s.sharpe.toFixed(2)}</b></div></div>
 ${line(d.curve,'v')}<div class="mu">포트폴리오 가치 (시작=100)</div>${line(d.curve,'dd','#ff5a5f')}<div class="mu">낙폭(%)</div>${corr}`}catch(e){$('#res').innerHTML=`<span class="err">${e.message}</span>`}};
load();
</script></body></html>
